{
  "name": "kestrel",
  "version": "0.1.0",
  "description": "Kestrel - 빠른 데스크톱 메일 클라이언트",
  "main": "./out/main/index.js",
  "author": "oein",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "electron-builder install-app-deps",
    "package": "electron-vite build && electron-builder --mac --dir"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "imapflow": "^2.1.2",
    "mailparser": "^3.9.32",
    "nodemailer": "^10.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "lucide-react": "^1.52.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "kr.oein.kestrel",
    "productName": "Kestrel",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    }
  }
}
